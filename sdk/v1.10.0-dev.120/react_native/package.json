{
  "name": "@mediaviz/react-native-sdk",
  "version": "1.10.0-dev.120",
  "description": "MediaViz React Native SDK \u2014 auto-generated endpoint client for React Native and Expo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mediaviz/mediaviz_sdk"
  },
  "keywords": [
    "mediaviz",
    "react-native",
    "expo",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/sdk.cjs",
  "module": "./dist/sdk.esm.js",
  "react-native": "./dist/sdk.esm.js",
  "types": "./dist/sdk.d.ts",
  "exports": {
    ".": {
      "react-native": "./dist/sdk.esm.js",
      "import": {
        "types": "./dist/sdk.esm.d.ts",
        "default": "./dist/sdk.esm.js"
      },
      "require": {
        "types": "./dist/sdk.d.cts",
        "default": "./dist/sdk.cjs"
      },
      "default": "./dist/sdk.cjs"
    },
    "./react": {
      "react-native": "./dist/react.esm.js",
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.esm.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      },
      "default": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
